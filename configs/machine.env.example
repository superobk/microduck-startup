# Copy to configs/machine.env on each machine. The real file is gitignored.
#
# macOS example:
#   MICRODUCK_ROLE="mac"
#   MICRODUCK_HOME="/Users/you/Microduck"
#   MICRODUCK_GPU_SSH="microduck-gpu"
#   MICRODUCK_GPU_HOME="/home/you/Microduck"
#
# GPU example:
#   MICRODUCK_ROLE="gpu"
#   MICRODUCK_HOME="/home/you/Microduck"

MICRODUCK_ROLE=""
MICRODUCK_HOME="${HOME}/Microduck"

# SSH config alias used only from macOS.
MICRODUCK_GPU_SSH=""

# Absolute workspace path on the GPU host; do not use ~ here.
MICRODUCK_GPU_HOME=""

# 0 means unlimited. Otherwise KiB/s, passed to rsync --bwlimit.
MICRODUCK_RSYNC_BWLIMIT=0

MICRODUCK_BROWSER_PORT=5173
MICRODUCK_TENSORBOARD_PORT=6006
MICRODUCK_VISER_PORT=8080
