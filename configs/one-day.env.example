# Copy to configs/one-day.env for local overrides. The real file is gitignored.
#
# Recommended first run:
#   ONE_DAY_PROFILE="walking"  # fastest proof of the full pipeline
#
# Recommended first short-action run:
#   ONE_DAY_PROFILE="roulade"  # uses the existing R/roll slot in the Space

ONE_DAY_PROFILE="walking"

# Leave empty to inherit from configs/one-day-profiles.json.
ONE_DAY_TASK_ID=""
ONE_DAY_SPACE_SLOT=""
ONE_DAY_TRAIN_ENVS=""
ONE_DAY_TRAIN_ITERS=""
ONE_DAY_REPLAY_STEPS=""

ONE_DAY_SMOKE_ENVS=64
ONE_DAY_SMOKE_ITERS=5
ONE_DAY_SEED=42
ONE_DAY_GPU="0"
ONE_DAY_LOGGER="tensorboard"
ONE_DAY_ENABLE_NAN_GUARD=true

ONE_DAY_VIDEO_WIDTH=960
ONE_DAY_VIDEO_HEIGHT=720

# Stable output name inside the bundle.
ONE_DAY_ONNX_NAME="policy.onnx"

# Optional publication targets. Use your own namespace first.
ONE_DAY_HF_MODEL_REPO=""
ONE_DAY_HF_SPACE_REPO=""
ONE_DAY_HF_SOURCE_SPACE="pollen-robotics/microduck-simulator"
ONE_DAY_HF_SPACE_PRIVATE=false
